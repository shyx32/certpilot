# 复制为 .env 后填写。两个值都必须设置，compose 会校验。

# 数据库密码
DB_PASSWORD=change-me

# 加密主密钥：用 `make genkey` 生成，并离线备份。
# 它不入库——丢失后所有凭据与私钥都无法恢复。
CP_MASTER_KEY=

# 对外端口
HTTP_PORT=8088

# 首次接入建议先用 staging 跑通全流程，确认无误再切生产，
# 避免浪费 Let's Encrypt 的签发配额。
# CP_ACME_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
